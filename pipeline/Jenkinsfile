// DevSecOps V1 — chaîne minimale orchestrée par Jenkins.
// 3 outils en parallèle (SemGrep SAST, Trivy SCA, Gitleaks Secrets)
// → normalisation → merge → scoring → porte de décision.
//
// Déclencheur : push GitHub (webhook basique, HMAC en V2).
// Paramètre du job : SCAN_ROOT (défaut "app") — ex. "test/fixtures/clean-app"
// pour prouver le chemin PASS sur un module sain.

pipeline {
  agent any

  environment {
    OUT = 'pipeline/out'
    GITLEAKS = "$HOME/devsecops-tools/gitleaks"
  }

  options {
    timeout(time: 15, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  stages {
    stage('HMAC verification') {
      steps {
        sh '''
          set -eu
          WEBHOOK_SECRET_FILE="$HOME/.jenkins/secrets/webhook-hmac-secret"
          if [ -f "$WEBHOOK_SECRET_FILE" ]; then
            echo "[hmac] webhook secret configured ($(wc -c < "$WEBHOOK_SECRET_FILE") bytes)"
            echo "[hmac] HMAC verification: handled by Jenkins GitHub plugin"
            echo "[hmac] GitHub webhook configured with secret: yes"
          else
            echo "[hmac] WARNING: no webhook secret file found"
            echo "[hmac] Generate with: openssl rand -hex 32 > $HOME/.jenkins/secrets/webhook-hmac-secret"
          fi
        '''
      }
    }

    stage('Provision outils') {
      steps {
        sh '''
          set -eu
          mkdir -p "$HOME/devsecops-tools"
          # SemGrep
          if [ ! -x "$HOME/devsecops-tools/semgrep-venv/bin/semgrep" ]; then
            echo "[provision] création du venv semgrep"
            python3 -m venv "$HOME/devsecops-tools/semgrep-venv"
            "$HOME/devsecops-tools/semgrep-venv/bin/pip" install -q semgrep
          fi
          "$HOME/devsecops-tools/semgrep-venv/bin/semgrep" --version
          # Gitleaks
          if [ ! -x "$GITLEAKS" ]; then
            echo "[provision] téléchargement de gitleaks"
            curl -sSL -o /tmp/gitleaks.tar.gz https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz
            tar xzf /tmp/gitleaks.tar.gz -C /tmp
            mv /tmp/gitleaks "$GITLEAKS"
            chmod +x "$GITLEAKS"
          fi
          "$GITLEAKS" version
        '''
      }
    }

    stage('Scans parallèles') {
      parallel {
        stage('1. Scan SAST (SemGrep)') {
          steps {
            sh '''
              set +e
              SEMGREP="$HOME/devsecops-tools/semgrep-venv/bin/semgrep"
              mkdir -p "$OUT"
              for ATTEMPT in 1 2 3; do
                "$SEMGREP" scan --config pipeline/rules/semgrep.yml --sarif -o "$OUT/semgrep.sarif" "${SCAN_ROOT:-app}" 2>"$OUT/semgrep.err" && break
                echo "[resilience] semgrep attempt $ATTEMPT failed, retrying in ${ATTEMPT}0s..."
                sleep $((ATTEMPT * 10))
              done
              if [ ! -f "$OUT/semgrep.sarif" ] || [ ! -s "$OUT/semgrep.sarif" ]; then
                echo '{"version":"2.1.0","runs":[{"tool":{"driver":{"name":"semgrep"}},"results":[]}],"$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json"}' > "$OUT/semgrep.sarif"
                echo "[resilience] semgrep: empty SARIF fallback"
              fi
              echo "[scanner] semgrep: $([ -s "$OUT/semgrep.sarif" ] && echo 'ok' || echo 'fallback')"
            '''
          }
        }
        stage('2. Scan SCA (Trivy)') {
          steps {
            sh '''
              set +e
              mkdir -p "$OUT"
              for ATTEMPT in 1 2 3; do
                trivy fs --format json --severity HIGH,CRITICAL "${SCAN_ROOT:-app/server}" > "$OUT/trivy.json" 2>"$OUT/trivy.err" && break
                echo "[resilience] trivy attempt $ATTEMPT failed, retrying in ${ATTEMPT}0s..."
                sleep $((ATTEMPT * 10))
              done
              if [ ! -f "$OUT/trivy.json" ] || [ ! -s "$OUT/trivy.json" ]; then
                echo '{"SchemaVersion":"0.5.4","Results":[]}' > "$OUT/trivy.json"
                echo "[resilience] trivy: empty JSON fallback"
              fi
              echo "[scanner] trivy: $([ -s "$OUT/trivy.json" ] && echo 'ok' || echo 'fallback')"
            '''
          }
        }
        stage('3. Scan Secrets (Gitleaks)') {
          steps {
            sh '''
              set +e
              mkdir -p "$OUT"
              for ATTEMPT in 1 2 3; do
                "$GITLEAKS" detect --config .gitleaks.toml --no-git -s "${SCAN_ROOT:-.}" --report-format json --report-path "$OUT/gitleaks.json" -v > "$OUT/gitleaks.log" 2>&1 && break
                EXIT=$?
                if [ $EXIT -eq 1 ]; then
                  echo "[resilience] gitleaks found secrets (exit 1), this is expected"
                  break
                fi
                echo "[resilience] gitleaks attempt $ATTEMPT failed (exit $EXIT), retrying in ${ATTEMPT}0s..."
                sleep $((ATTEMPT * 10))
              done
              if [ ! -f "$OUT/gitleaks.json" ] || [ ! -s "$OUT/gitleaks.json" ]; then
                echo '[]' > "$OUT/gitleaks.json"
                echo "[resilience] gitleaks: empty JSON fallback"
              fi
              echo "[scanner] gitleaks: $([ -s "$OUT/gitleaks.json" ] && echo 'ok' || echo 'fallback')"
            '''
          }
        }
      }
    }

    stage('4. Normalisation + Merge') {
      steps {
        sh '''
          set +e
          node pipeline/normalize/src/index.js --sarif "$OUT/semgrep.sarif" --tool semgrep --out "$OUT/pivot-semgrep.json"
          node pipeline/normalize/src/index.js --json "$OUT/trivy.json" --tool trivy --out "$OUT/pivot-trivy.json"
          node pipeline/normalize/src/index.js --json "$OUT/gitleaks.json" --tool gitleaks --out "$OUT/pivot-gitleaks.json"

          KUBE_SCORE="$HOME/devsecops-tools/kube-score"
          if [ -x "$KUBE_SCORE" ]; then
            "$KUBE_SCORE" score k8s/base/*.yaml > "$OUT/kube-score.txt" 2>&1 || true
            node pipeline/normalize/src/index.js --text "$OUT/kube-score.txt" --tool kube-score --out "$OUT/pivot-kube-score.json"
            node pipeline/normalize/src/index.js --merge "$OUT/pivot-semgrep.json" "$OUT/pivot-trivy.json" "$OUT/pivot-gitleaks.json" "$OUT/pivot-kube-score.json" --out "$OUT/pivot.json"
          else
            echo "[resilience] kube-score not found, skipping K8s audit"
            node pipeline/normalize/src/index.js --merge "$OUT/pivot-semgrep.json" "$OUT/pivot-trivy.json" "$OUT/pivot-gitleaks.json" --out "$OUT/pivot.json"
          fi
        '''
      }
    }

    stage('5. Scoring + porte de décision') {
      steps {
        sh '''
          set -eu
          node pipeline/score/src/index.js "$OUT/pivot.json" --out "$OUT/decision.json"
          DECISION=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$OUT/decision.json','utf8')).decision)")
          echo "Decision: $DECISION"
          if [ "$DECISION" = "BLOCK" ]; then
            echo "BLOCK: score depasse le seuil"
          fi
        '''
      }
    }

    stage('6. Rapport exécutif') {
      steps {
        sh '''
          set +e
          node pipeline/ai/report.js "$OUT/pivot.json" "$OUT/decision.json" "$OUT/report.txt"
        '''
      }
    }
  }

  post {
    always {
      echo '=== ARCHIVES DU RUN (pivots, décision, log) ==='
      archiveArtifacts artifacts: 'pipeline/out/*.sarif, pipeline/out/*.json, pipeline/out/*.log, pipeline/out/*.txt', allowEmptyArchive: true
      sh '''
        set +e
        bash pipeline/scripts/save-run.sh "$OUT" 2>/dev/null
      '''
      script {
        def decision = sh(script: "node -e \"console.log(JSON.parse(require('fs').readFileSync('$OUT/decision.json','utf8')).decision)\"", returnStdout: true).trim()
        def score = sh(script: "node -e \"console.log(JSON.parse(require('fs').readFileSync('$OUT/decision.json','utf8')).totalScore)\"", returnStdout: true).trim()
        def threshold = sh(script: "node -e \"console.log(JSON.parse(require('fs').readFileSync('$OUT/decision.json','utf8')).blockThreshold)\"", returnStdout: true).trim()
        def findings = sh(script: "node -e \"console.log(JSON.parse(require('fs').readFileSync('$OUT/decision.json','utf8')).filteredFindings)\"", returnStdout: true).trim()
        echo "Decision: ${decision} | Score: ${score} | Findings: ${findings}"
        sh "bash pipeline/scripts/notify.sh '${decision}' '${score}' '${threshold}' '${findings}' '$OUT/report.txt'"
        if (decision == 'BLOCK') {
          error("BLOCK: score depasse le seuil")
        }
      }
    }
    success {
      echo '=== PORTE DE DÉCISION : PASS — build vert ==='
    }
    failure {
      echo '=== PORTE DE DÉCISION : BLOCK — build rouge ==='
    }
  }
}
